    {
      "type": "timeseries",
      "title": "Reconnects since boot",
      "description": "WiFi drops and MQTT reconnects since each node's last boot. Rising counts mean an unstable connection.",
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "telemetry-sqlite"
          },
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT ts AS time, hub || ' WiFi' AS hub, wifi_reconnects FROM device_${res} WHERE ts >= $__from / 1000 AND ts < $__to / 1000 UNION ALL SELECT ts AS time, hub || ' MQTT' AS hub, mqtt_connects - 1 FROM device_${res} WHERE ts >= $__from / 1000 AND ts < $__to / 1000 ORDER BY time",
          "queryText": "SELECT ts AS time, hub || ' WiFi' AS hub, wifi_reconnects FROM device_${res} WHERE ts >= $__from / 1000 AND ts < $__to / 1000 UNION ALL SELECT ts AS time, hub || ' MQTT' AS hub, mqtt_connects - 1 FROM device_${res} WHERE ts >= $__from / 1000 AND ts < $__to / 1000 ORDER BY time",
          "timeColumns": [
            "time",
            "ts"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
