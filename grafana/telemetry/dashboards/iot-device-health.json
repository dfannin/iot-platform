    {
      "type": "state-timeline",
      "title": "Online / offline",
      "description": "From the retained status messages: ONLINE after each connect, OFFLINE from the MQTT last will (about 90 s after a node stops responding).",
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "telemetry-sqlite"
          },
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT ts AS time, hub, state FROM state_events\nWHERE topic LIKE '%/status' AND ts >= $__from / 1000 AND ts < $__to / 1000\nUNION ALL\nSELECT $__from / 1000 AS time, e.hub, e.state FROM state_events e\nWHERE e.id = (SELECT MAX(e2.id) FROM state_events e2 WHERE e2.topic = e.topic AND e2.ts < $__from / 1000) AND e.topic LIKE '%/status'\nORDER BY time",
          "queryText": "SELECT ts AS time, hub, state FROM state_events\nWHERE topic LIKE '%/status' AND ts >= $__from / 1000 AND ts < $__to / 1000\nUNION ALL\nSELECT $__from / 1000 AS time, e.hub, e.state FROM state_events e\nWHERE e.id = (SELECT MAX(e2.id) FROM state_events e2 WHERE e2.topic = e.topic AND e2.ts < $__from / 1000) AND e.topic LIKE '%/status'\nORDER BY time",
          "timeColumns": [
            "time",
            "ts"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "ONLINE": {
                  "color": "green",
                  "index": 0
                },
                "OFFLINE": {
                  "color": "red",
                  "index": 1
                },
                "OPEN": {
                  "color": "orange",
                  "index": 2
                },
                "CLOSED": {
                  "color": "green",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "displayName": "${__field.labels.hub}"
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
