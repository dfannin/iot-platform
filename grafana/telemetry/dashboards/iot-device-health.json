    {
      "type": "bargauge",
      "title": "Telemetry received",
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "telemetry-sqlite"
          },
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "WITH first AS (SELECT hub, MIN(ts - COALESCE(interval_s, 300)) AS first_ts FROM device_5m GROUP BY hub)\nSELECT d.hub, MIN(100.0, ROUND(100.0 * SUM(COALESCE(d.interval_s, 300))\n       / MAX(300.0, $__to / 1000.0 - MAX($__from / 1000.0, f.first_ts) - 300), 1)) AS received\nFROM device_5m d JOIN first f ON f.hub = d.hub\nWHERE d.ts >= $__from / 1000 AND d.ts < $__to / 1000 GROUP BY d.hub ORDER BY d.hub",
          "queryText": "WITH first AS (SELECT hub, MIN(ts - COALESCE(interval_s, 300)) AS first_ts FROM device_5m GROUP BY hub)\nSELECT d.hub, MIN(100.0, ROUND(100.0 * SUM(COALESCE(d.interval_s, 300))\n       / MAX(300.0, $__to / 1000.0 - MAX($__from / 1000.0, f.first_ts) - 300), 1)) AS received\nFROM device_5m d JOIN first f ON f.hub = d.hub\nWHERE d.ts >= $__from / 1000 AND d.ts < $__to / 1000 GROUP BY d.hub ORDER BY d.hub",
          "timeColumns": []
        }
      ],
      "description": "Share of the time range covered by device telemetry (every 5 minutes), counted from the node's first report if it is newer than the range. Below 100 % means missed reports: offline, reboots, WiFi or broker problems.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^received$/"
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left"
      },
