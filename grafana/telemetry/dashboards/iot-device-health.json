  "panels": [
    {
      "type": "table",
      "title": "Devices",
      "description": "Every node that sends device telemetry or an online/offline status. last_seen is the age of its latest message. last_reset: why it last restarted (BROWNOUT = power supply, PANIC / WATCHDOG = firmware crash or hang). Reconnect counts are since the last boot.",
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "telemetry-sqlite"
          },
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "WITH hubs AS (SELECT hub FROM device_5m UNION SELECT hub FROM state_events WHERE topic LIKE '%/status'),\nlast AS (SELECT hub, MAX(ts) AS ts FROM device_5m GROUP BY hub),\ntel AS (SELECT x.* FROM device_5m x JOIN last ON x.hub = last.hub AND x.ts = last.ts),\nst AS (SELECT e.hub, e.state FROM state_events e WHERE e.id = (SELECT MAX(e2.id) FROM state_events e2 WHERE e2.topic = e.topic) AND e.topic LIKE '%/status'),\nseen AS (SELECT hub, MAX(ts) AS ts FROM (SELECT hub, ts FROM device_5m UNION ALL\n         SELECT hub, ts FROM state_events WHERE state != 'OFFLINE') GROUP BY hub),\nboot AS (SELECT hub, firmware, reset_reason, MAX(ts) AS ts FROM boots GROUP BY hub)\nSELECT h.hub AS device, COALESCE(st.state, '?') AS status,\n       strftime('%s', 'now') - seen.ts AS \"last seen\",\n       boot.firmware AS firmware,\n       COALESCE(CASE tel.reset_reason WHEN 0 THEN 'UNKNOWN' WHEN 1 THEN 'POWERON' WHEN 2 THEN 'EXTERNAL' WHEN 3 THEN 'SOFTWARE' WHEN 4 THEN 'PANIC' WHEN 5 THEN 'INT_WATCHDOG' WHEN 6 THEN 'TASK_WATCHDOG' WHEN 7 THEN 'WATCHDOG' WHEN 8 THEN 'DEEPSLEEP' WHEN 9 THEN 'BROWNOUT' WHEN 10 THEN 'SDIO' END, boot.reset_reason) AS \"last reset\",\n       boot.ts AS \"last boot\",\n       tel.rssi AS rssi, tel.uptime_s AS uptime,\n       tel.free_heap AS \"free heap\", tel.min_free_heap AS \"lowest heap\",\n       tel.mqtt_connects - 1 AS \"MQTT reconnects\", tel.wifi_reconnects AS \"WiFi reconnects\"\nFROM hubs h LEFT JOIN tel ON tel.hub = h.hub LEFT JOIN st ON st.hub = h.hub\nLEFT JOIN seen ON seen.hub = h.hub LEFT JOIN boot ON boot.hub = h.hub\nORDER BY h.hub",
          "queryText": "WITH hubs AS (SELECT hub FROM device_5m UNION SELECT hub FROM state_events WHERE topic LIKE '%/status'),\nlast AS (SELECT hub, MAX(ts) AS ts FROM device_5m GROUP BY hub),\ntel AS (SELECT x.* FROM device_5m x JOIN last ON x.hub = last.hub AND x.ts = last.ts),\nst AS (SELECT e.hub, e.state FROM state_events e WHERE e.id = (SELECT MAX(e2.id) FROM state_events e2 WHERE e2.topic = e.topic) AND e.topic LIKE '%/status'),\nseen AS (SELECT hub, MAX(ts) AS ts FROM (SELECT hub, ts FROM device_5m UNION ALL\n         SELECT hub, ts FROM state_events WHERE state != 'OFFLINE') GROUP BY hub),\nboot AS (SELECT hub, firmware, reset_reason, MAX(ts) AS ts FROM boots GROUP BY hub)\nSELECT h.hub AS device, COALESCE(st.state, '?') AS status,\n       strftime('%s', 'now') - seen.ts AS \"last seen\",\n       boot.firmware AS firmware,\n       COALESCE(CASE tel.reset_reason WHEN 0 THEN 'UNKNOWN' WHEN 1 THEN 'POWERON' WHEN 2 THEN 'EXTERNAL' WHEN 3 THEN 'SOFTWARE' WHEN 4 THEN 'PANIC' WHEN 5 THEN 'INT_WATCHDOG' WHEN 6 THEN 'TASK_WATCHDOG' WHEN 7 THEN 'WATCHDOG' WHEN 8 THEN 'DEEPSLEEP' WHEN 9 THEN 'BROWNOUT' WHEN 10 THEN 'SDIO' END, boot.reset_reason) AS \"last reset\",\n       boot.ts AS \"last boot\",\n       tel.rssi AS rssi, tel.uptime_s AS uptime,\n       tel.free_heap AS \"free heap\", tel.min_free_heap AS \"lowest heap\",\n       tel.mqtt_connects - 1 AS \"MQTT reconnects\", tel.wifi_reconnects AS \"WiFi reconnects\"\nFROM hubs h LEFT JOIN tel ON tel.hub = h.hub LEFT JOIN st ON st.hub = h.hub\nLEFT JOIN seen ON seen.hub = h.hub LEFT JOIN boot ON boot.hub = h.hub\nORDER BY h.hub",
          "timeColumns": [
            "time",
            "ts",
            "last boot"
          ]
        }
      ],
