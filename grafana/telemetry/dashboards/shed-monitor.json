    {
      "type": "timeseries",
      "title": "Power",
      "description": "Average power. Battery: + charging, - discharging. Solar uses battery voltage (common-positive controller), so it reads about 35 % low.",
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "telemetry-sqlite"
          },
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT ts AS time, MAX(CASE WHEN sensor = 'solar' THEN power END) AS \"Solar (reads low)\", MAX(CASE WHEN sensor = 'battery' THEN power END) AS \"Battery\" FROM power_${res} WHERE hub = '$hub' AND ts >= $__from / 1000 AND ts < $__to / 1000 GROUP BY ts ORDER BY ts",
          "queryText": "SELECT ts AS time, MAX(CASE WHEN sensor = 'solar' THEN power END) AS \"Solar (reads low)\", MAX(CASE WHEN sensor = 'battery' THEN power END) AS \"Battery\" FROM power_${res} WHERE hub = '$hub' AND ts >= $__from / 1000 AND ts < $__to / 1000 GROUP BY ts ORDER BY ts",
          "timeColumns": [
            "time",
            "ts"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true,
            "showPoints": "never",
            "axisBorderShow": false
          },
          "decimals": 1
