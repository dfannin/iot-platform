{
  "uid": "shed-monitor",
  "title": "Shed Monitor",
  "tags": [
    "shed",
    "esp32"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "5m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "hub",
        "label": "Hub",
        "query": "shed00",
        "current": {
          "text": "shed00",
          "value": "shed00"
        },
        "hide": 0
      },
      {
        "type": "custom",
        "name": "res",
        "label": "Resolution",
        "query": "5m,1h",
        "description": "5m: 5-minute points (kept 2 years). 1h: hourly summaries (kept forever), faster for long ranges.",
        "current": {
          "text": "5m",
          "value": "5m"
        },
        "options": [
          {
            "text": "5m",
            "value": "5m",
            "selected": true
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          }
        ],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Alerts",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "frser-sqlite-datasource",
          "uid": "telemetry-sqlite"
        },
        "target": {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "telemetry-sqlite"
          },
          "refId": "Anno",
          "queryType": "table",
          "rawQueryText": "SELECT ts AS time, hub || ' ' || sensor || ': ' || state || COALESCE(' (' || NULLIF(reason, '') || ')', '') AS text, state AS tags FROM alerts WHERE ts >= $__from / 1000 AND ts < $__to / 1000 AND kind NOT IN ('reminder', 'brief') ORDER BY ts",
          "queryText": "SELECT ts AS time, hub || ' ' || sensor || ': ' || state || COALESCE(' (' || NULLIF(reason, '') || ')', '') AS text, state AS tags FROM alerts WHERE ts >= $__from / 1000 AND ts < $__to / 1000 AND kind NOT IN ('reminder', 'brief') ORDER BY ts",
          "timeColumns": [
            "time",
            "ts"
          ]
        }
      }
    ]
  },
