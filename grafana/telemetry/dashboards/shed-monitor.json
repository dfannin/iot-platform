          "queryText": "SELECT ts AS time, bus_voltage_min AS \"min\", bus_voltage AS \"avg\", bus_voltage_max AS \"max\" FROM power_${res} WHERE hub = '$hub' AND sensor = 'battery' AND ts >= $__from / 1000 AND ts < $__to / 1000 ORDER BY ts",
