    {
      "type": "barchart",
      "title": "Daily energy (last 30 days)",
      "description": "From the hourly summaries. Charged / discharged are the battery's positive and negative energy. Solar uses battery voltage, so it reads low (see README).",
      "timeFrom": "30d",
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "telemetry-sqlite"
          },
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT date(ts, 'unixepoch', 'localtime') AS day, ROUND(SUM(CASE WHEN sensor = 'battery' THEN energy_in_wh END), 1) AS \"Battery charged\", ROUND(SUM(CASE WHEN sensor = 'battery' THEN energy_out_wh END), 1) AS \"Battery discharged\", ROUND(SUM(CASE WHEN sensor = 'solar' THEN energy_in_wh END), 1) AS \"Solar (reads low)\" FROM power_1h WHERE hub = '$hub' AND ts >= $__from / 1000 AND ts < $__to / 1000 GROUP BY day ORDER BY day",
          "queryText": "SELECT date(ts, 'unixepoch', 'localtime') AS day, ROUND(SUM(CASE WHEN sensor = 'battery' THEN energy_in_wh END), 1) AS \"Battery charged\", ROUND(SUM(CASE WHEN sensor = 'battery' THEN energy_out_wh END), 1) AS \"Battery discharged\", ROUND(SUM(CASE WHEN sensor = 'solar' THEN energy_in_wh END), 1) AS \"Solar (reads low)\" FROM power_1h WHERE hub = '$hub' AND ts >= $__from / 1000 AND ts < $__to / 1000 GROUP BY day ORDER BY day",
